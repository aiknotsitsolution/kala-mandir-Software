# ---------------------------------------------------------------------------
# Kalamandir Dance Institute — backend environment
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# MongoDB connection string (Atlas or local).
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/<db>?appName=<app>
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/kalamandir_dance?appName=Cluster0

# Long random string used to sign JWTs (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on. Render sets this automatically — leave as-is locally.
PORT=4000

# Comma-separated list of allowed browser origins (CORS).
# Local dev (Vite on 5173/5174) is always allowed.
# Production: CLIENT_ORIGIN=https://your-frontend.vercel.app
CLIENT_ORIGIN=http://localhost:5173
