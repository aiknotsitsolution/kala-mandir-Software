{
  "name": "kalamandir-api",
  "version": "1.0.0",
  "description": "Kalamandir Dance Institute — Express + MongoDB backend",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node scripts/seed.js",
