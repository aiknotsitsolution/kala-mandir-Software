# ---------------------------------------------------------------------------
# Kalamandir Dance Institute — frontend environment (Vite)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Backend API base URL (see backend-server/.env.example).
# Local:  VITE_API_URL=http://localhost:4000/api
# Prod:   VITE_API_URL=https://your-api.onrender.com/api
VITE_API_URL=http://localhost:4000/api

# Offline demo mode: a fully working local sample dataset with a permanent
# "DEMO MODE" badge. Only used when VITE_API_URL is empty or unset.
# Never enable in production.
VITE_DEMO_MODE=false

# Single business timezone used for membership validity, reports and
# "today" calculations (IANA name).
VITE_GYM_TIMEZONE=Asia/Kolkata

# Optional branding shown on login / membership cards / receipts.
VITE_GYM_NAME=Kalamandir Dance Institute
